worker_processes 1;
events { worker_connections 4096; }

http {
    lua_package_path "D:/Library/Desktop/nginx-replay-firewall/replayfirewall/?.lua;;";
    lua_shared_dict rfw 64m;

    # 生产环境必须开启；off 仅用于调试，会显著放大首屏时序抖动。
    lua_code_cache on;

    include mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;

    server {
        listen 18080;
        server_name localhost;
        set $rfw_on 1;

        location /cgi-rfw/ {
            access_by_lua_file D:/Library/Desktop/nginx-replay-firewall/replayfirewall/ma_rfw.lua;
            header_filter_by_lua_block {
                local m = _G.ma_rfw_core
                if m and m.header_filter then m.header_filter() end
            }
            content_by_lua_block {
                local f = loadfile("D:/Library/Desktop/nginx-replay-firewall/replayfirewall/webui.lua")
                if f then
                    local cgi = f()
                    if cgi and cgi.run then return cgi.run() end
                end
                ngx.status = 500
                ngx.say("webui not found")
            }
        }

        # 仅对明确的 HTML 文档 exact location 设置标记；不要在整个
        # /portal-web/ 前缀 location 设置，否则会把 API/Controller 误标为文档。
        location = /portal-web/ {
            set $rfw_document 1;
            access_by_lua_file D:/Library/Desktop/nginx-replay-firewall/replayfirewall/ma_rfw.lua;
            header_filter_by_lua_block {
                local m = _G.ma_rfw_core
                if m and m.header_filter then m.header_filter() end
            }
            proxy_pass http://127.0.0.1:18081;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Cookie $http_cookie;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        location /portal-web/ {
            access_by_lua_file D:/Library/Desktop/nginx-replay-firewall/replayfirewall/ma_rfw.lua;
            header_filter_by_lua_block {
                local m = _G.ma_rfw_core
                if m and m.header_filter then m.header_filter() end
            }
            proxy_pass http://127.0.0.1:18081;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Cookie $http_cookie;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        # 根首页同样使用 exact location；如实际文档入口不同，按
        # dynamic_document_paths 增加对应的 exact location，并保留 set。
        location = / {
            set $rfw_document 1;
            access_by_lua_file D:/Library/Desktop/nginx-replay-firewall/replayfirewall/ma_rfw.lua;
            header_filter_by_lua_block {
                local m = _G.ma_rfw_core
                if m and m.header_filter then m.header_filter() end
            }
            proxy_pass http://127.0.0.1:18081;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Cookie $http_cookie;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        location / {
            access_by_lua_file D:/Library/Desktop/nginx-replay-firewall/replayfirewall/ma_rfw.lua;
            header_filter_by_lua_block {
                local m = _G.ma_rfw_core
                if m and m.header_filter then m.header_filter() end
            }
            proxy_pass http://127.0.0.1:18081;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Cookie $http_cookie;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }
    }
}
