{
    "___secret": "共享密钥(用于请求签名/cookie 签名)",
    "secret": "N9x_Ant1_r3p14y!",

    "___shared_dict": "nginx 共享内存配置, nginx.conf 必须声明: lua_shared_dict rfw 64m;",
    "shared_dict": {
        "dict_name": "rfw",
        "key_prefix": "rfw:"
    },

    "___cookie": "cookie 配置",
    "cookie_name": "_RFW",
    "cookie_ttl": 86400,
    "cookie_ts_max": 60,
    "cookie_bootstrap": true,
    "cookie_replay_window": 2,
    "cookie_replay_max": 5,

    "___seq": "会话序号",
    "seq_slack": 10,
    "seq_ttl": 86400,
    "seq_cache_ttl": 3,

    "___sign": "签名校验",
    "sign_enabled": true,
    "sign_window": 60,
    "sign_ratio_req": 10,
    "sign_ratio_min": 0.5,
    "sign_ratio_fail": false,

    "___static_ext": "静态资源扩展名(不参与签名校验)",
    "static_ext": [
        ".html", ".htm", ".js", ".css",
        ".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".bmp", ".ico",
        ".woff", ".woff2", ".ttf", ".eot", ".map", ".pdf"
    ],

    "___cookie_ratio": "覆盖率判定",
    "cookie_ratio_req": 10,
    "cookie_ratio_min": 0.5,
    "cookie_ratio_fail": false,

    "___cookie_missing": "无 cookie 日配额(0 = 关闭)",
    "cookie_missing_max": 50,
    "cookie_missing_ttl": 86400,

    "___replay": "重放检测",
    "replay_enabled": true,
    "replay_threshold": 5,
    "replay_relink_sec": 2,

    "___penalty": "惩罚: 窗口内失败 fail_max 次 → 封禁 block_time 秒",
    "fail_max": 5,
    "fail_window": 60,
    "block_time": 600,
    "block_cache_ttl": 60,

    "___status": "状态页",
    "status_enabled": true,
    "status_path": "/cgi-rfw/status",

    "___sweep": "后台清扫间隔(秒)",
    "sweep_interval": 60,

    "___admin_whitelist": "管理面板访问白名单(留空 = 允许所有)",
    "admin_whitelist": ["127.0.0.1", "::1"],

    "___debug": "调试模式",
    "debug": false,

    "___app_fail": "后端失败检测(可选)",
    "app_fail_enabled": false,
    "app_fail_statuses": [502, 503, 504],
    "app_fail_paths": []
}
