{
  "key_mode": "dynamic",
  "dynamic_strict_sign": true,
  "dynamic_sign_ratio_fail": true,
  "dynamic_allow_cookie_fallback": false,
  "dynamic_document_paths": ["/", "/portal-web/"],
  "dynamic_cookie_tag_hex": 32,

  "key_ttl": 1800,
  "key_grace": 90,
  "key_advance_refresh": 30,
  "key_bind_ip": true,
  "key_bind_ua": true,
  "key_fetch_quota": 1000,
  "key_quota_window": 86400,
  "token_rate_limit": 10,
  "token_rate_window": 60,

  "shared_dict": {
    "dict_name": "rfw",
    "key_prefix": "rfw:"
  },

  "cookie_name": "_RFW",
  "cookie_ttl": 86400,
  "cookie_ts_max": 300,
  "cookie_bootstrap": true,
  "cookie_replay_window": 2,
  "cookie_replay_max": 5,
  "cookie_safe_methods": ["GET", "HEAD", "OPTIONS"],
  "cookie_rebootstrap_document": true,
  "cookie_document_require_fetch_metadata": false,

  "seq_slack": 10,
  "seq_ttl": 86400,
  "seq_cache_ttl": 3,

  "sign_enabled": true,
  "sign_window": 60,
  "sign_ratio_req": 10,
  "sign_ratio_min": 0.5,

  "static_ext": [
    ".html", ".htm", ".js", ".css",
    ".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".bmp", ".ico",
    ".woff", ".woff2", ".ttf", ".eot", ".map", ".pdf"
  ],

  "cookie_ratio_req": 10,
  "cookie_ratio_min": 0.5,
  "cookie_missing_max": 50,
  "cookie_missing_ttl": 86400,

  "replay_enabled": true,
  "replay_threshold": 5,
  "replay_relink_sec": 2,

  "fail_max": 5,
  "fail_window": 60,
  "block_time": 600,
  "block_cache_ttl": 60,

  "sweep_interval": 60,
  "snap_log_interval": 1800,

  "admin_whitelist": ["127.0.0.1", "::1"],
  "admin_trusted_proxies": [],
  "debug": false
}
