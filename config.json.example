{
  "__COMMENT_CONFIG_FORMAT": "标准 JSON；所有以 __ 开头的字段都是备注，运行时会忽略。",
  "__COMMENT_RELEASE": "Replay Firewall 发布版本：v4.3.5。请与 Lua、WebUI、rfw.js 使用同一发布包。",
  "__COMMENT_DYNAMIC_DOCUMENT_PATHS": "文档 HTML 精确路径；只能填写确定返回 HTML 的入口。",
  "dynamic_document_paths": [
    "/",
    "/webapp/"
  ],
  "__COMMENT_STRICT_API_PATHS": "额外严格 API 前缀；留空表示所有非文档请求按严格策略处理。",
  "strict_api_paths": [],

  "__COMMENT_DYNAMIC_KEY": "dynamic 密钥生命周期与发放限制。",
  "key_ttl": 1800,
  "key_grace": 90,
  "key_advance_refresh": 30,
  "key_fetch_quota": 1000,
  "key_quota_window": 86400,
  "token_rate_limit": 10,
  "token_rate_window": 60,

  "__COMMENT_COOKIE_FALLBACK": "Cookie fallback 默认关闭；WebUI 不显示此开关，开启后也只允许安全读请求。",
  "dynamic_allow_cookie_fallback": false,
  "cookie_ttl": 86400,
  "cookie_ts_max": 300,
  "cookie_replay_window": 2,
  "cookie_replay_max": 5,
  "cookie_document_require_fetch_metadata": false,

  "__COMMENT_COOKIE_REPLAY": "Cookie 时效、会话序号和重放限制；安全方法同值最多 8 次。",
  "cookie_missing_max": 50,
  "cookie_missing_ttl": 86400,

  "__COMMENT_SIGN": "MA-RFW-Data 时间窗口和签名比例异常检测。",
  "sign_window": 60,
  "sign_ratio_req": 10,
  "sign_ratio_min": 0.5,
  "cookie_ratio_req": 10,
  "cookie_ratio_min": 0.5,

  "__COMMENT_SEQUENCE": "Cookie 会话序号与缓存。",
  "seq_slack": 10,
  "seq_ttl": 86400,
  "seq_cache_ttl": 3,

  "__COMMENT_REPLAY": "请求重放检测固定开启；这里只调整阈值和二次校验窗口。",
  "replay_threshold": 5,
  "replay_relink_sec": 2,

  "__COMMENT_FAILURE": "失败计数与 IP 封禁。",
  "fail_max": 5,
  "fail_window": 60,
  "block_time": 600,
  "block_cache_ttl": 60,

  "sweep_interval": 60,
  "snap_log_interval": 1800,

  "__COMMENT_ADMIN": "管理面板访问控制。",
  "admin_whitelist": [
    "127.0.0.1",
    "::1"
  ],
  "admin_trusted_proxies": [],
  "debug": false
}
